{
  "name": "sonar-custom-plugin-secai",
  "license": "LGPL-3.0",
  "version": "7.0.0",
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "autoprefixer": "^6.2.2",
    "babel-jest": "^29.7.0",
    "babel-loader": "^8.4.1",
    "cross-env": "2.0.0",
    "cross-spawn": "4.0.0",
    "css-loader": "^6.11.0",
    "detect-port": "1.0.0",
    "dotenv": "2.0.0",
    "expose-loader": "0.7.1",
    "express": "4.13.4",
    "express-http-proxy": "0.6.0",
    "file-loader": "^6.2.0",
    "filesize": "3.3.0",
    "find-cache-dir": "0.1.1",
    "gzip-size": "3.0.0",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "0.6.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "json-loader": "0.5.4",
    "mini-css-extract-plugin": "^2.9.2",
    "path-exists": "2.1.0",
    "postcss-loader": "^6.2.1",
    "prettier": "0.22.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-refresh": "^0.17.0",
    "react-transform-hmr": "1.0.4",
    "recursive-readdir": "2.1.0",
    "redux-mock-store": "^1.5.5",
    "rimraf": "2.5.4",
    "script-loader": "0.6.1",
    "strip-ansi": "3.0.1",
    "style-loader": "^3.3.4",
    "webpack": "^5.99.7",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "test": "node scripts/test.js"
  },
  "jest": {
    "testEnvironment": "jest-environment-jsdom",
    "setupFiles": [
      "<rootDir>/conf/jest/SetupTestEnvironment.js"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom/extend-expect"
    ],
    "coverageDirectory": "<rootDir>/target/coverage",
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/tests"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/scripts",
      "<rootDir>/conf"
    ],
    "moduleFileExtensions": [
      "jsx",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^.+\\.(hbs|jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/conf/jest/FileStub.js",
      "^.+\\.css$": "<rootDir>/conf/jest/CSSStub.js"
    },
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    }
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tailwindcss/cli": "^4.0.0",
    "backbone": "^1.4.0",
    "d3-drag": "^1.2.1",
    "d3-force": "^1.1.0",
    "d3-selection": "^1.3.0",
    "d3-shape": "^1.3.7",
    "d3-zoom": "^1.8.3",
    "jquery": "^1.11.0",
    "react-diff-viewer-continued": "^3.4.0",
    "react-icons": "^5.4.0",
    "react-loading-skeleton": "^3.5.0",
    "react-lottie": "^1.2.10",
    "react-redux": "^7.2.4",
    "reactflow": "^11.11.4",
    "sass": "^1.83.4",
    "tailwindcss": "^4.0.0",
    "underscore": "^1.9.1",
    "yarn": "^1.22.22"
  },
  "packageManager": "yarn@4.5.0"
}
